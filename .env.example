# Copy this file to .env.local for local development,
# and add the same two values in your Vercel project's Settings -> Environment Variables.

# Your Neon connection string (Neon dashboard -> Connection Details -> "Pooled connection").
# It looks like: postgres://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Any long random string you make up yourself. Protects the /api/cron/backup endpoint
# so nobody else can trigger it. Vercel sends this automatically to your own cron job
# once you set the same value in your Vercel project's environment variables.
CRON_SECRET=
